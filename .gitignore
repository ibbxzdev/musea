# dependencies
node_modules/
.pnpm-store/

# build output
.next/
out/
dist/
build/
.turbo/
*.tsbuildinfo

# rust / soroban
target/
**/*.rs.bk

# convex
.convex/

# env — NEVER commit. See .env.example for the shape.
.env
.env.*
!.env.example
!.env.local.example

# stellar testnet identities produced by scripts/ — these hold SECRET KEYS
.stellar/
*.stellar-keys.json
secrets/

# editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
._*

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# test / coverage
coverage/
.vercel/

# AI assistant tooling and agent guidance. Local only, not part of the deliverable.
# A pattern with no slash matches at every level, so apps/web/CLAUDE.md is covered too.
.claude/
CLAUDE.md
.agents/
skills-lock.json

# generated by Next on every build
apps/web/next-env.d.ts

# Working documents — local only. The SOW carries the budget, the primary contact's email
# and the Ambassador chapter lead's name, none of which belong in a public repo. The
# public, submission-facing documentation lives in docs/ and IS committed.
internal-docs/

.vercel

# Never commit a real environment file. The two examples are listed back in explicitly:
# they hold no values, and they are the documentation of what has to be set.
.env*
!.env.example
!apps/web/.env.local.example
